# Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma-separated; strict CORS. The SPA is served same-origin by nginx in docker.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Bootstrap admin (created on first start when no users exist) ------------
ADMIN_EMAIL=admin@anchorage.local
ADMIN_PASSWORD=

# --- Database / cache --------------------------------------------------------
POSTGRES_USER=anchorage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anchorage
# Used by local (non-docker) runs; docker-compose builds its own URL.
DATABASE_URL=postgresql+asyncpg://anchorage:change-me@127.0.0.1:5432/anchorage
# Empty = in-process memory bus (single process dev only)
REDIS_URL=redis://127.0.0.1:6379/0

# --- CTI data source (read-only) ---------------------------------------------
# Folder that contains darkweb_intel/ and telegram-scraper/
CTI_DATA_DIR=../Darkweb_CTI/Darkweb_CTI
# sqlite (default) | http | none
CTI_SOURCE_MODE=sqlite
# HttpSource (disabled by default). Only GET /api/iocs is ever called.
CTI_HTTP_ENABLED=false
CTI_HTTP_BASE_URL=http://127.0.0.1:8000
CTI_HTTP_TOKEN=
# Demo fixture produced by `make seed-demo`; ingested in addition to CTI_DATA_DIR
DEMO_CTI_DIR=./data/demo-cti
DEMO_DATA_ENABLED=true

# --- Scheduler ---------------------------------------------------------------
SYNC_HOURLY_MINUTE=5
SYNC_DAILY_HOUR_UTC=7
SYNC_DAILY_MINUTE=0

# --- Real-time seam ----------------------------------------------------------
ENABLE_SIMULATOR=false
SIMULATOR_INTERVAL_SECONDS=8
# Optional shared secret for machine-to-machine POST /api/events/ingest
INGEST_TOKEN=

# --- Ports (bound to 127.0.0.1 only) ------------------------------------------
WEB_PORT=8088
API_PORT=8077
